# ═════════════════════════════════════════════════════════════════
#  agent-v10 版本层配置（可选）
#
#  ⚠️ 可选，大概率不需要创建 —— 不写也能跑，全部有默认值。
#  ⚠️ 不要在这里写 API Key（Key 属于共享层，见仓库根 .env）。
#
#  用法：cp .env.example .env  之后按需取消注释。
#  优先级：真实环境变量 > 这个文件 > 仓库根 .env
# ═════════════════════════════════════════════════════════════════


# ── 规划（v10 的核心）────────────────────────────────────────────

# 规划总开关。设 0 = 退回 walk-through（评估里当对照组用）。
#   LLM_PLANNING_ENABLED=0 python main.py --eval --tag no-plan
LLM_PLANNING_ENABLED=1

# 计划最多拆几步（超上限的计划会被判坏 → 重试 → 降级）。
LLM_PLAN_MAX_STEPS=8

# 规划最多尝试几次（第一次没交好计划，再给一次机会）。
LLM_PLAN_MAX_ATTEMPTS=2

# 规划用哪个模型（留空 = 跟随 LLM_MODEL）。
# 实验：填一个不存在的名字，看「规划失败 → 降级」的样子。
LLM_PLANNER_MODEL=

# 规划提示词文件。
LLM_PLANNER_PROMPT_FILE=prompts/planner.md

# ⚠️ 实验开关：人为把计划写坏（两种坏法，只在日志里说明，模型不知情）。
#   drop_last —— 砍掉计划最后一步；reverse —— 颠倒计划顺序
# 用法：LLM_PLAN_SABOTAGE=drop_last python main.py
LLM_PLAN_SABOTAGE=


# ── 评估参数（沿用 v9）────────────────────────────────────────────

# 评估时的采样温度。默认 0（尺子自己不能晃）。
LLM_EVAL_TEMPERATURE=0.0

# 裁判模型（留空 = 跟随 LLM_MODEL）。
LLM_JUDGE_MODEL=

# 裁判回复的 token 上限。
# ⚠️ 别调太小：实测 100~200 时 deepseek-flash 会「思考到没电」，
#    可见内容为空 → 判定失败（报错里会说「被截断」）。
LLM_JUDGE_MAX_TOKENS=600

# 执行 Agent 的提示词文件（v10 与原版一字不改，作对照前提）。
LLM_SYSTEM_PROMPT_FILE=prompts/system.md

# 用例集文件 / 运行记录目录（想拿自己的题集跑，就指过去）。
LLM_EVAL_CASES=evals/cases.jsonl
LLM_EVAL_RUNS_DIR=runs


# ── 工具与目录 ──────────────────────────────────────────────────

# save_note 写到哪里。
LLM_NOTES_DIR=notes

# 临时关掉某个工具（逗号分隔）。被关的工具不会出现在给模型的清单里 ——
# 评估会把它当成「能力损失」测出来（v9 实验 4）。
#   LLM_DISABLED_TOOLS=calculator
LLM_DISABLED_TOOLS=


# ── 对话参数 ────────────────────────────────────────────────────

# 交互对话的温度（评估用上面那个单独的 LLM_EVAL_TEMPERATURE）。
LLM_TEMPERATURE=0.3
