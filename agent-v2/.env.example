# ═════════════════════════════════════════════════════════════════
#  agent-v2 的版本专属配置
#
#  ⚠️ 这是【可选】文件 —— 大概率你根本不需要创建它。
#
#  ⚠️ 这里不要写 API Key！
#    密钥等共享配置在【仓库根】的 .env 里，所有版本共用那一份。
#    本文件只负责「v2 独有的调参」。
#
#  ─────────────────────────────────────────────────────────────
#  什么时候才需要它？
#
#    想让 v2 用一套不同的参数，而且不想影响别的版本时。
#
#        cp .env.example .env          # 在 agent-v2/ 目录下执行
#
#  只是想临时试一下？连文件都不用建，直接用环境变量：
#
#        LLM_MAX_CONTEXT_TOKENS=800 python main.py
#
#  不想改任何东西？那就当它不存在，代码里都有默认值。
#  ─────────────────────────────────────────────────────────────
#
#  加载优先级：真实环境变量  >  agent-v2/.env  >  仓库根/.env
# ═════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────
#  上下文管理
#
#  【谁在用】v1 ✗   v2 ✓   v3 ✓     ← v1 没有上下文管理，不读这三项
#
#  所以它们属于「v2 引入的能力」，而不是「全项目共享」。
# ─────────────────────────────────────────────────────────────────

# messages 的 token 预算，超出就开始剪枝。
#
# ⚠️ 故意默认 4000（很小），这样你随便聊几句就能看到剪枝在工作。
#    想看它剪枝：聊 3~4 轮，或者故意问一个会调用工具的长问题。
#    不想看到剪枝：调到 100000。
#
#    生产环境请改成「模型真实上下文窗口 × 0.7」，
#    比如 64K 的模型设 45000，128K 的设 90000。
LLM_MAX_CONTEXT_TOKENS=4000

# 最近多少条消息永不剪枝。当前这一轮和上一轮通常最相关，动不得。
LLM_KEEP_RECENT=8

# 单个工具返回值最多保留多少字符（超出就地截断）。
# 这是上下文管理的第一道闸：与其事后剪，不如一开始就别让它进来。
LLM_MAX_TOOL_RESULT_CHARS=2000


# ─────────────────────────────────────────────────────────────────
#  实验开关：临时「关掉」某些工具
#
#  【谁在用】只给 EXPERIMENTS.md 里的实验 4 / 5 用，平时留空
#
#  被关掉的工具不会出现在给模型的 tools 清单里 —— 等于模型根本不知道它存在。
#  这是感受「没有工具时模型有多弱」最直接的办法。
#
#  直接在命令行用更省事，不用改这个文件：
#
#      LLM_DISABLED_TOOLS=calculator python main.py
#      LLM_DISABLED_TOOLS=calculator,get_current_time python main.py
# ─────────────────────────────────────────────────────────────────

# 逗号分隔的工具名，留空 = 全部启用
LLM_DISABLED_TOOLS=
