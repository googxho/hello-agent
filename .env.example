# ═════════════════════════════════════════════════════════════════
#  hello-agent —— 共享配置（全项目唯一一份）
#
#      cp .env.example .env        ← 只需做这一次
#
#  ┌───────────────────────────────────────────────────────────┐
#  │  这个文件只放【跨版本共享】的配置。                        │
#  │  各版本自己特有的调参，不在这里 ——                           │
#  │  见 agent-vN/.env.example（且那一个是可选的）。            │
#  └───────────────────────────────────────────────────────────┘
#
#  .env 已被根目录 .gitignore 忽略，不会被提交。
# ═════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────
#  LLM 连接
#
#  【谁在用】v1 ✓   v2 ✓   以后的版本 ✓     ← 所有版本都读
#
#  这三项和「版本」无关：它们描述的是「你是谁的账号、连哪家服务」，
#  换个版本并不会换账号，所以放共享层最合适。
# ─────────────────────────────────────────────────────────────────

# 必填：模型 API Key
LLM_API_KEY=

# 可选：接口地址
#   DeepSeek     https://api.deepseek.com
#   OpenAI       https://api.openai.com/v1
#   通义千问      https://dashscope.aliyuncs.com/compatible-mode/v1
#   月之暗面      https://api.moonshot.cn/v1
#   本地 Ollama   http://localhost:11434/v1    （Key 随便填，如 ollama）
LLM_BASE_URL=https://api.deepseek.com

# 可选：模型名
# ⚠️ 必须选一个「支持 tool calling（函数调用）」的模型。
#   DeepSeek     deepseek-chat
#   OpenAI       gpt-4o-mini
#   通义千问      qwen-plus
#   本地 Ollama   qwen2.5:7b
LLM_MODEL=deepseek-chat
