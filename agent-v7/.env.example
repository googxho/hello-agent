# ═════════════════════════════════════════════════════════════════
#  agent-v7 的版本专属配置
#
#  ⚠️ 这是【可选】文件 —— 大概率你根本不需要创建它。
#
#  ⚠️ 这里不要写 API Key！
#    密钥等共享配置在【仓库根】的 .env 里，所有版本共用那一份。
#    本文件只负责「这个版本独有的调参」。
#
#  ─────────────────────────────────────────────────────────────
#  什么时候才需要它？
#
#    想让这个版本用一套不同的参数，而且不想影响别的版本时。
#
#        cp .env.example .env          # 在 agent-v7/ 目录下执行
#
#  只是想临时试一下？连文件都不用建，直接用环境变量：
#
#        LLM_MAX_CONTEXT_TOKENS=800 python main.py
#        LLM_SUMMARY_ENABLED=0 python main.py
#        LLM_PERSIST_ENABLED=0 python main.py
#        LLM_RRF_K=0 python main.py
#
#  不想改任何东西？那就当它不存在，代码里都有默认值。
#  ─────────────────────────────────────────────────────────────
#
#  加载优先级：真实环境变量  >  agent-v7/.env  >  仓库根/.env
# ═════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────
#  上下文管理（v2 引入，v3/v4 继续用）
#
#  【谁在用】v1 ✗   v2 ✓   v3 ✓   v4 ✓   v5 ✓   v6 ✓   v7 ✓    ← v1 没有上下文管理，不读这三项
#
#  它们属于「v2 引入的能力」，不是「全项目共享」，所以也没放进共享层。
# ─────────────────────────────────────────────────────────────────

# messages 的 token 预算，超出就开始瘦身（先剪枝，再压缩）。
#
# ⚠️ 故意默认 4000（很小），这样你随便聊几句就能看到剪枝和压缩在工作。
#    想看压缩：把预算压到 800 左右，聊 3~4 轮就行。
#    不想看到任何瘦身：调到 100000。
#
#    生产环境请改成「模型真实上下文窗口 × 0.7」，
#    比如 64K 的模型设 45000，128K 的设 90000。
LLM_MAX_CONTEXT_TOKENS=4000

# 最近多少条消息永不剪枝、也永不压进摘要。
# 当前这一轮和上一轮通常最相关，动不得 —— 它们是「短期记忆」。
LLM_KEEP_RECENT=8

# 单个工具返回值最多保留多少字符（超出就地截断）。
# 这是上下文管理的第一道闸：与其事后剪，不如一开始就别让它进来。
LLM_MAX_TOOL_RESULT_CHARS=2000


# ─────────────────────────────────────────────────────────────────
#  上下文压缩（v3 新增，v4 继续用）
#
#  【谁在用】v1 ✗   v2 ✗   v3 ✓   v4 ✓   v5 ✓   v6 ✓   v7 ✓
#
#  v3 的核心：超预算时，不再直接丢掉旧对话，而是先让 LLM 把它概括成
#  一条摘要，再用摘要换掉原文。用少量 token 保住关键信息。
# ─────────────────────────────────────────────────────────────────

# 开关（1 / 0）。关掉之后，v3 会退回 v2 的「丢弃」行为 ——
# 这是做对比实验用的：亲手把新能力拿掉，看它怎么坏。
#
#     LLM_SUMMARY_ENABLED=0 python main.py
LLM_SUMMARY_ENABLED=1

# 压缩用哪个模型。留空 = 跟随 LLM_MODEL。
#
# 为什么要单独开一个口子？因为「压缩」和「干活」是两类完全不同的任务 ——
# 把一段话读短，便宜的小模型往往就够；省下的钱是实打实的。
#
#     LLM_SUMMARY_MODEL=gpt-4o-mini python main.py
#
# 💡 顺便它还是个绝佳的实验入口：填一个不存在的模型名，
#    就能安全地观察「压缩失败」长什么样（见 EXPERIMENTS.md 实验 7）。
LLM_SUMMARY_MODEL=

# 摘要最多输出多少 token —— 「压缩比 vs 保真度」的旋钮。
#   · 太小 → 摘要短得装不下关键信息，压了等于没压
#   · 太大 → 摘要不再是摘要，省不下 token，压缩就白做了
LLM_SUMMARY_MAX_TOKENS=500

# 可压内容少于这个 token 数时，懒得压，直接丢。
# 调得太大会让压缩「永远凑不够量」，v3 就会退回 v2 的失忆行为 ——
# 好在日志里会出现「⏭ 没有走压缩：…」，把原因和数字摆出来。
LLM_MIN_COMPACT_TOKENS=200


# ─────────────────────────────────────────────────────────────────
#  持久化记忆（v4 新增）
#
#  【谁在用】v1 ✗   v2 ✗   v3 ✗   v4 ✓   v5 ✓   v6 ✓   v7 ✓
#
#  v4 的核心：把会话（消息 + 摘要）写进磁盘，启动时读回来。
#  关掉它，就退回 v3 的「退出即蒸发」。
# ─────────────────────────────────────────────────────────────────

# 开关（1 / 0）。
#
#     LLM_PERSIST_ENABLED=0 python main.py
LLM_PERSIST_ENABLED=1

# 会话存到哪个文件。留空 = 默认 agent-v4/session.json。
#
# 一场会话一个文件 —— 想保存多场？复制文件就是「存档」：
#
#     cp session.json 项目A.json                    # 存档
#     LLM_SESSION_FILE=项目A.json python main.py    # 切回去
#
# ⚠️ 别让两个程序同时指向同一个文件：目前没有并发保护，后写的会覆盖先写的。
LLM_SESSION_FILE=


# ─────────────────────────────────────────────────────────────────
#  本地检索（v5 新增）
#
#  【谁在用】v1 ✗   v2 ✗   v3 ✗   v4 ✗   v5 ✓   v6 ✓   v7 ✓
#
#  v5 的核心：先去资料里找，再把找到的塞进上下文。
#  关掉它，就退回 v4（它连你有笔记这件事都不知道）。
# ─────────────────────────────────────────────────────────────────

# 开关（1 / 0）。关掉时 search_notes 会从模型的工具清单里**消失**，
# 不是「它调了、但被拒绝」—— 后者会让模型困惑，还多烧一次调用。
#
#     LLM_RETRIEVAL_ENABLED=0 python main.py
LLM_RETRIEVAL_ENABLED=1

# 资料目录 —— 它要读的「图书馆」在哪。留空 = 本版本的 notes/。
#
# 想让它读你自己的文档？指过去就行（只认 .md / .txt / .markdown）：
#
#     LLM_NOTES_DIR=~/我的文档 python main.py
LLM_NOTES_DIR=

# 每次检索带回来几段。
#
# ⚠️ 这是「找得全」和「别把上下文塞满」之间的平衡。
#    调大到 20 试试？你会看到请求的 token 数明显上涨（见实验 5）。
LLM_RETRIEVAL_TOP_K=5

# 一块最大多少字符（切分粒度）。
#
# 太小 → 一段话被切碎（bigram 会碎得拼不回去）；
# 太大 → 一块里混着好几件事，检索不准。
# 想看极端效果：LLM_CHUNK_MAX_CHARS=40（见实验 6）。
LLM_CHUNK_MAX_CHARS=600


# ─────────────────────────────────────────────────────────────────
#  向量检索（v6 新增）
#
#  【谁在用】v1 ✗   v2 ✗   v3 ✗   v4 ✗   v5 ✗   v6 ✓   v7 ✓
#
#  v6 的核心：把文字变成向量，按「意思」找，而不是按「字」找。
# ─────────────────────────────────────────────────────────────────

# 检索模式：hybrid（v7 默认：关键词 + 向量两个都跑）
#           / semantic（v6：只比意思）/ keyword（v5：只比字面）。
#
# 想并排看三种「找法」的差别？来回切着跑一遍：
#
#     LLM_RETRIEVAL_MODE=keyword python main.py
#     LLM_RETRIEVAL_MODE=semantic python main.py
LLM_RETRIEVAL_MODE=hybrid

# 相关性门槛（余弦相似度，0~1）。低于它的一律不算命中。
#
# ⚠️ 0.5 只对「bge-m3 + 普通中文笔记」成立 ——
#    换模型或换语料都得重新校准（见 EXPERIMENTS.md 实验 2）。
#    调低 = 宁滥毋缺；调高 = 宁缺毋滥。没有普适值。
LLM_MIN_SIMILARITY=0.5

# 向量缓存文件（留空 = agent-v7/embedding-cache.json）。
#
# ⚠️ 不是可选项 —— embedding 按 token 计费，
#    没缓存就变成「每次启动都重新烧钱」。
LLM_EMBEDDING_CACHE=


# ─────────────────────────────────────────────────────────────────
#  混合检索（v7 新增）
#
#  【谁在用】v1 ✗   v2 ✗   v3 ✗   v4 ✗   v5 ✗   v6 ✗   v7 ✓
#
#  v7 的核心：两个检索器都跑，用 RRF（倒数排名融合）按【名次】合并。
#  为什么不是把分数加起来？因为量纲完全不同（BM25 打分 vs 0~1 余弦）——
#  直接相加是「谁量大谁说话」，不是「谁说得对谁说话」。
# ─────────────────────────────────────────────────────────────────

# 融合常数 k（默认 60，Cormack 等 2009 的经验值）。
#
# 它是「共识的含金量」旋钮：
#     k 大 → 两边都提名 > 单边第一名（默认行为）
#     k 小 → 单边霸权抬头，谁家第一名谁说了算
#
# 想亲手看它翻转？把实验 5 的脚本里 k 从 60 改成 0，
# 或者真对话里直接试：
#
#     LLM_RRF_K=0 python main.py
LLM_RRF_K=60

# 每一路最多提名几段进融合（默认 10）。
#
# ⚠️ 名单之外 = 没有名次 = 贡献 0 分。取太小，另一路的好结果没机会
#    吃到「共识加成」；取太大，低质量提名会稀释前排。
LLM_HYBRID_DEPTH=10


# ─────────────────────────────────────────────────────────────────
#  采样温度（v6 修正 —— v1~v5 一直没设过）
#
#  ⚠️ 这是 v6 补的一个「历史遗留」：从 v1 到 v5，代码里从来没有传过
#     temperature —— 一直在默默吃 API 的默认值（DeepSeek 是 1.0）。
#
#     后果实测：同一句「我想让程序跑得更快」问两次，
#     一次它调用 search_notes 去查笔记，一次直接凭自己的知识答了一大篇 ——
#     实验根本没法复现。
#
#  Agent 和「写文章」的诉求正好相反：写作要文采，Agent 要**稳定**。
# ─────────────────────────────────────────────────────────────────

# 0 = 每次都挑最可能的下一个词；1 = 更随机。
LLM_TEMPERATURE=0.3

# ─────────────────────────────────────────────────────────────────
#  向量模型（属于【共享层】配置，写在这里只是给你看）
#
#  ⚠️ 这三项应该放在【仓库根】的 .env 里，不要写在这个文件的版本层！
#     它和 LLM_* 一样属于「你连哪家服务」，换版本不会变。
#     另外：它和对话模型是**两家服务**，密钥各是各的。
#
#      EMBEDDING_API_KEY=sk-...
#      EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#      EMBEDDING_MODEL=BAAI/bge-m3
#
#  没配也不会崩：它会退回关键词检索，并在横幅里说明原因。
# ─────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────
#  实验开关：临时「关掉」某些工具
#
#  【谁在用】只给 EXPERIMENTS.md 里的能力边界实验用，平时留空
#
#  被关掉的工具不会出现在给模型的 tools 清单里 —— 等于模型根本不知道它存在。
#
#  直接在命令行用更省事，不用改这个文件：
#
#      LLM_DISABLED_TOOLS=calculator python main.py
#      LLM_DISABLED_TOOLS=calculator,get_current_time python main.py
# ─────────────────────────────────────────────────────────────────

# 逗号分隔的工具名，留空 = 全部启用
LLM_DISABLED_TOOLS=
