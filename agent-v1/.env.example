# ─────────────────────────────────────────────────────────────
# 复制本文件为 .env 并填入你的配置：  cp .env.example .env
# .env 已被 .gitignore 忽略，不会被提交，可以放心写密钥。
# ─────────────────────────────────────────────────────────────

# ── 必填：模型 API Key ───────────────────────────────────────
LLM_API_KEY=


# ── 可选：接口地址 ──────────────────────────────────────────
# 默认已指向 DeepSeek。想换别家只改这一行，代码不用动。
#   DeepSeek    https://api.deepseek.com
#   OpenAI      https://api.openai.com/v1
#   通义千问     https://dashscope.aliyuncs.com/compatible-mode/v1
#   月之暗面     https://api.moonshot.cn/v1
#   本地 Ollama  http://localhost:11434/v1     （Key 随便填，如 ollama）
LLM_BASE_URL=https://api.deepseek.com


# ── 可选：模型名 ────────────────────────────────────────────
# ⚠️ 必须选一个「支持 tool calling（函数调用）」的模型，否则 Agent 跑不起来。
#   DeepSeek    deepseek-chat
#   OpenAI      gpt-4o-mini
#   通义千问     qwen-plus
#   本地 Ollama  qwen2.5:7b
LLM_MODEL=deepseek-chat
